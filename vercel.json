{
  "version": 2,
  "builds": [
    {
      "src": "server.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": [
          "tests/**",
          "docs/**",
          "scripts/**",
          "instance/**",
          ".venv/**",
          ".git/**",
          "**/__pycache__/**",
          "**/.env",
          "**/.env.*",
          ".agents/**",
          ".taste-skill/**",
          "skills-lock.json"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.py"
    }
  ],
  "regions": [
    "sin1"
  ]
}
