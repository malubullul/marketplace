# Reference only; load through your shell/IDE or Vercel Environment Variables.
# STORE project only. Use Supabase Connect -> Transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_ENCODED_PASSWORD@POOLER_HOST:6543/postgres
SUPABASE_URL=https://yvhjbmpblqqzqotxbpba.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=product-photos
# Generate separate random secrets, each at least 32 characters. Do not commit values.
ANREDSELLER_SESSION_SECRET=
ANREDSELLER_ADMIN_GATEWAY_KEY=
ANREDSELLER_ADMIN_PORTAL_URL=https://YOUR_ADMIN_PROJECT.vercel.app
ANREDSELLER_SECURE_COOKIES=1
# Password recovery: Resend, with a sender on your verified domain (STORE only).
ANREDSELLER_PUBLIC_URL=https://marketplace-theta-ebon.vercel.app
RESEND_API_KEY=
ANREDSELLER_EMAIL_FROM=
# Enable only after migration 005 and a working verified Resend sender.
ANREDSELLER_REQUIRE_VERIFIED_EMAIL=0
# Optional expiry scheduler bearer secret (random, >=32 chars; STORE only).
CRON_SECRET=
