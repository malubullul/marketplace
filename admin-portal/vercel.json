{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": [
          ".venv/**",
          "**/__pycache__/**",
          ".env",
          ".env.*"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/app.py"
    }
  ],
  "regions": [
    "sin1"
  ]
}
